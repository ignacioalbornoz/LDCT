{
    "name": "sketchy_binary_optimized",
    "phase": "train",
    "gpu_ids": [0],
    "path": {
        "log": "logs_binary",
        "tb_logger": "tb_logger_binary",
        "results": "results_binary",
        "checkpoint": "checkpoint_binary",
        "resume_state": null
    },
    "datasets": {
        "train": {
            "name": "sketchy_edges2sketch",
            "mode": "HR",
            "dataroot": "/home/shared_data/Datasets/sketchy/train",
            "datatype": "img",
            "l_resolution": 256,
            "r_resolution": 256,
            "batch_size": 16,
            "num_workers": 4,
            "use_shuffle": true,
            "data_len": -1
        },
        "val": {
            "name": "sketchy_edges2sketch",
            "mode": "HR",
            "dataroot": "/home/shared_data/Datasets/sketchy/train",
            "datatype": "img",
            "l_resolution": 256,
            "r_resolution": 256,
            "data_len": 100
        }
    },
    "model": {
        "which_model_G": "sr3",
        "finetune_norm": false,
        "unet": {
            "in_channel": 2,
            "out_channel": 1,
            "inner_channel": 128,
            "norm_groups": 16,
            "channel_multiplier": [1, 2, 4, 8],
            "attn_res": [16],
            "res_blocks": 2,
            "dropout": 0.1
        },
        "beta_schedule": {
            "train": {
                "schedule": "cosine",
                "n_timestep": 1000,
                "linear_start": 1e-6,
                "linear_end": 1e-2
            },
            "val": {
                "schedule": "cosine",
                "n_timestep": 1000,
                "linear_start": 1e-6,
                "linear_end": 1e-2
            }
        },
        "diffusion": {
            "image_size": 256,
            "channels": 1,
            "conditional": true
        }
    },
    "train": {
        "n_iter": 500000,
        "val_freq": 200,
        "save_checkpoint_freq": 500,
        "print_freq": 50,
        "optimizer": {
            "type": "adamw",
            "lr": 1e-3,
            "weight_decay": 1e-4,
            "betas": [0.9, 0.999]
        },
        "scheduler": {
            "type": "cosine",
            "warmup_steps": 500
        },
        "ema_scheduler": {
            "step_start_ema": 1000,
            "update_ema_every": 1,
            "ema_decay": 0.999
        },
        "gradient_clip": 1.0,
        "loss_scale": 1.0
    },
    "wandb": {
        "project": "sketchy_binary_optimized"
    }
} 